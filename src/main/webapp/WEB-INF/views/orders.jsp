<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><meta charset="UTF-8"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"><title>Order history · FreshCart</title></head><body><header><a class="brand" href="${pageContext.request.contextPath}/">fresh<span>•</span>cart</a><a href="${pageContext.request.contextPath}/">Shop</a></header><main><h1>Order history & delivery status</h1><c:choose><c:when test="${empty orders}"><p>No orders have been placed yet.</p></c:when><c:otherwise><c:forEach items="${orders}" var="o"><article class="order"><h2>Order #<c:out value="${o.id}"/></h2><p><strong>Status:</strong> <c:out value="${o.status}"/> · <c:out value="${o.payment}"/></p><p><strong>Placed:</strong> <c:out value="${o.date}"/></p><p><strong>Deliver to:</strong> <c:out value="${o.address}"/></p><p class="total">Total ₹<c:out value="${o.total}"/></p></article></c:forEach></c:otherwise></c:choose><p class="muted">Tracking status is the current order state recorded by the demo system. No courier integration is connected.</p></main></body></html>
