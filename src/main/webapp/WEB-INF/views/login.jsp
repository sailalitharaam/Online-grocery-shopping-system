<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><meta charset="UTF-8"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"><title>Customer sign in</title></head><body><main class="auth"><a class="brand" href="${pageContext.request.contextPath}/">fresh<span>•</span>cart</a><h1>Sign in</h1><c:if test="${not empty message}"><p class="notice"><c:out value="${message}"/></p></c:if><form method="post"><input type="hidden" name="action" value="login"><label>Email<input type="email" name="email" required></label><label>Password<input type="password" name="password" required></label><button>Sign in</button></form><p>New to FreshCart? <a href="?action=register">Create an account</a></p></main></body></html>
