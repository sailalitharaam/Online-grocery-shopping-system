<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><meta charset="UTF-8"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"><title>Your Cart · FreshCart</title></head><body><header><a class="brand" href="${pageContext.request.contextPath}/">fresh<span>•</span>cart</a><a href="${pageContext.request.contextPath}/">Continue shopping</a></header><main><h1>Your shopping cart</h1><c:if test="${not empty message}"><p class="notice"><c:out value="${message}"/></p></c:if><c:choose><c:when test="${empty cart}"><p>Your cart is empty.</p></c:when><c:otherwise><table><tr><th>Product</th><th>Unit</th><th>Quantity</th><th>Line total</th><th></th></tr><c:forEach items="${cart}" var="entry"><tr><td><c:out value="${entry.value.product.name}"/></td><td>₹<c:out value="${entry.value.product.price}"/></td><td><form method="post" class="inline"><input type="hidden" name="action" value="quantity"><input type="hidden" name="id" value="${entry.key}"><input type="number" min="0" name="qty" value="${entry.value.quantity}"><button>Update</button></form></td><td>₹<c:out value="${entry.value.subtotal}"/></td><td><form method="post"><input type="hidden" name="action" value="remove"><input type="hidden" name="id" value="${entry.key}"><button class="secondary">Remove</button></form></td></tr></c:forEach></table><form method="post" class="checkout"><input type="hidden" name="action" value="checkout"><label>Delivery address<textarea name="address" required minlength="8"></textarea></label><p>Payment: Cash on delivery (demo)</p><button>Place order</button></form></c:otherwise></c:choose></main></body></html>
