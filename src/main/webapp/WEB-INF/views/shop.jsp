<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FreshCart groceries</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><header><a class="brand" href="${pageContext.request.contextPath}/">fresh<span>•</span>cart</a><form class="search" method="get"><input name="q" value="<c:out value='${query}'/>" placeholder="Search groceries"><button>Search</button></form><nav><a href="${pageContext.request.contextPath}/?action=cart">Cart</a><c:choose><c:when test="${not empty sessionScope.customer}"><a href="${pageContext.request.contextPath}/?action=orders">My Orders</a><span>Hi, <c:out value="${sessionScope.customer.name}"/></span><form method="post"><input type="hidden" name="action" value="logout"><button class="link">Sign out</button></form></c:when><c:otherwise><a href="${pageContext.request.contextPath}/?action=login">Sign in</a><a href="${pageContext.request.contextPath}/?action=register">Register</a></c:otherwise></c:choose></nav></header><main><section class="hero"><small>FRESH PICKS, DELIVERED DAILY</small><h1>Good food starts with a good cart.</h1><p>Everyday groceries, carefully selected for your home.</p></section><h2>Shop by category</h2><div class="chips"><a href="${pageContext.request.contextPath}/">All</a><c:forEach items="${categories}" var="cat"><a href="?category=<c:out value='${cat}'/>"><c:out value="${cat}"/></a></c:forEach></div><h2>Popular groceries</h2><section class="grid"><c:forEach items="${products}" var="p"><article class="card"><div class="emoji">🛒</div><small><c:out value="${p.category}"/></small><h3><c:out value="${p.name}"/></h3><p><c:out value="${p.unit}"/> · ₹<c:out value="${p.price}"/></p><form method="post"><input type="hidden" name="action" value="add"><input type="hidden" name="id" value="${p.id}"><button>Add to cart</button></form></article></c:forEach></section></main><footer>FreshCart · WTS Team 2 academic project</footer></body></html>
